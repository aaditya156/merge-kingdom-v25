# Merge Kingdom 2.5 Backend Environment Configuration

PROJECT_NAME="Merge Kingdom 2.5 API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL / SQLite async)
# For Postgres: postgresql+asyncpg://user:password@localhost:5432/merge_kingdom
# For SQLite: sqlite+aiosqlite:///./merge_kingdom.db
DATABASE_URL="sqlite+aiosqlite:///./merge_kingdom.db"

# JWT Security
SECRET_KEY="development_secret_key_change_in_production_jwt_signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Virtual Economy & Migration Settings
CONVERSION_RATIO_COINS_TO_GEMS=1.0
FREE_GEM_BONUS=0
